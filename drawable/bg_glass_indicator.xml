<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Smooth glowing background simulating magnification -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26FFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <!-- Smooth colorful border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <stroke android:width="2dp">
                <gradient
                    android:type="linear"
                    android:angle="45"
                    android:startColor="#8000FF66"
                    android:endColor="#800088FF" />
            </stroke>
        </shape>
    </item>
</layer-list>
